@page
@model RegisterModel

@{
    ViewData["Title"] = "Registrera användare";
}

<form id="registerForm"
      method="post"
      asp-route-returnUrl="@Model.ReturnUrl"
      class="auth-form">

    <h2>Skapa konto</h2>

    <!-- Felmeddelanden -->
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <div class="auth-form-row">
        <label asp-for="Input.Email">E-post:</label>
        <input asp-for="Input.Email" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="auth-form-row">
        <label asp-for="Input.Password">Lösenord:</label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="auth-form-row">
        <label asp-for="Input.ConfirmPassword">Bekräfta lösenord:</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <br />

    <div>
        <input type="submit" value="Registrera" class="submit-btn" />
    </div>

    <div class="login-links">
        <p>
            Har du redan ett konto? <br>
            <a asp-page="./Login">Logga in</a>
        </p>
    </div>

</form>

<div class="navigate-back">
    <a asp-action="Index" asp-controller="Home">
        Tillbaka till startsidan
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}