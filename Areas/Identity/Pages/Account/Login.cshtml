@page
@model LoginModel

@{
    ViewData["Title"] = "Logga in";
}

<form id="account" method="post" class="auth-form">

    <h2>Logga in</h2>

    <!-- Felmeddelanden -->
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <div class="auth-form-row">
        <label asp-for="Input.Email">E-post:</label>
        <input asp-for="Input.Email" autocomplete="username" />
    </div>

    <div class="auth-form-row">
        <label asp-for="Input.Password">Lösenord:</label>
        <input asp-for="Input.Password" autocomplete="current-password" />
    </div>

    <div class="auth-form-row remember-row">
        <label asp-for="Input.RememberMe">Kom ihåg mig:</label>
        <input asp-for="Input.RememberMe" />
    </div>
    <br>

    <div>
        <input type="submit" value="Logga in" class="submit-btn" />
    </div>

    <div class="login-links">
        <br>
        <p>
            <a asp-page="./Register">Registrera ny användare</a>
        </p>
        <br>
        <p>
            Glömt lösenord? <br>Kontakta administratör
        </p>
    </div>

</form>

<div class="navigate-back">
    <a asp-action="Index">Tillbaka till startsidan</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}