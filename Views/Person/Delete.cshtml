@model DiveLogg.Models.Person

@{
    ViewData["Title"] = "Delete";
}

<h1>Ta bort</h1>

<h3>Är du säker på att du vill ta bort personen?</h3>
<div>
    <h4>Person</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Namn
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            Grupp
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Group.Name)
        </dd>
        <dt class="col-sm-2">
            Roller
        </dt>
        <dd class="col-sm-10">

            @if (Model.PersonRoles != null && Model.PersonRoles.Any())
            {
                <ul>
                    @foreach (var personRole in Model.PersonRoles)
                    {
                        <li>
                            @{
                                var roleName = personRole.Role.Name switch
                                {
                                    "DiveLeader" => "Dykledare",
                                    "Diver" => "Dykare",
                                    "DiveSupport" => "Dykskötare",
                                    _ => personRole.Role.Name
                                };
                            }
                            @roleName
                        </li>

                    }
                </ul>
            }
            else
            {
                <span>Inga roller tilldelade</span>
            }

        </dd>
        <dt class="col-sm-2">
            Skapad
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
    </dl>

    <form asp-action="Delete" onsubmit="return confirm('Är du säker på att du vill radera denna person?');">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Ta bort" class="btn btn-danger" /> |
        <a asp-action="Index">Tillbaka till lista</a>
    </form>

</div>