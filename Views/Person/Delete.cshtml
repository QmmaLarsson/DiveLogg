@model DiveLogg.Models.Person

@{
    ViewData["Title"] = "Delete";
}

<h1>Ta bort</h1>

<h2>Är du säker på att du vill ta bort personen?</h2>

<div class="person-card">

    <h3 class="person-title">
        @Model.Name
    </h3>

    <div class="person-content">

        <dl class="person-details">

            <dt>Grupp</dt>
            <dd>@Html.DisplayFor(model => model.Group.Name)</dd>

            <dt>Skapad</dt>
            <dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt>Roller</dt>
            <dd>
                @if (Model.PersonRoles != null && Model.PersonRoles.Any())
                {
                    <ul class="role-list">
                        @foreach (var personRole in Model.PersonRoles)
                        {
                            var roleName = personRole.Role.Name switch
                            {
                                "DiveLeader" => "Dykledare",
                                "Diver" => "Dykare",
                                "DiveSupport" => "Dykskötare",
                                _ => personRole.Role.Name
                            };

                            <li>@roleName</li>
                        }
                    </ul>
                }
                else
                {
                    <span>Inga roller tilldelade</span>
                }
            </dd>

        </dl>

    </div>

    <form class="person-actions" asp-action="Delete"
          onsubmit="return confirm('Är du säker på att du vill radera denna person?');">
        <input type="hidden" asp-for="Id" />
        <input class="person-btn" type="submit" value="Ta bort" />
        <a class="person-btn" asp-action="Index">Tillbaka till lista</a>
    </form>

</div>