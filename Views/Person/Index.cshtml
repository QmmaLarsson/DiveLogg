@model IEnumerable<DiveLogg.Models.Person>

@{
    ViewData["Title"] = "Index";
    Layout = "_LayoutPattern";
}

<h1>Personal</h1>

<div class="page-container">
    <div class="table-tools">
        <form method="get" class="person-filter-form">
            <select name="groupId" asp-items="ViewBag.Groups" onchange="this.form.submit()"><option value="">Alla grupper</option></select>
        </form>
        <a asp-action="Create" class="table-btn add-btn">Ny person</a>
    </div>
    <div class="table-container">
        <table class="person-table">
            <thead>
                <tr>
                    <th>
                        Namn
                    </th>
                    <th>
                        Grupp
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Group.Name)
                        </td>
                        <td>
                            <div class="button-wrapper">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="table-btn">Redigera</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="table-btn">Detaljer</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="table-btn">Ta bort</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index" asp-route-page="@i" class="@(ViewBag.CurrentPage == i ? "active-page" : "")">
                    @i
                </a>
            }
        </div>
    }
</div>