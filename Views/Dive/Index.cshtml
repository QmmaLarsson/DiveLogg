@model IEnumerable<DiveLogg.Models.Dive>

@{
    ViewData["Title"] = "Index";
    Layout = "_LayoutPattern";
}

<h1>Dyklogg</h1>

<div class="page-container">
    <div class="table-tools">
        <form method="get" class="dive-filter-form">

            <select name="groupId" asp-items="ViewBag.Groups" onchange="this.form.submit()">
            </select>

            <select name="personId" asp-items="ViewBag.Persons" onchange="this.form.submit()">
                <option value="">Alla personer</option>
            </select>

        </form>
        <a asp-action="Create" class="table-btn add-btn">Nytt dyk</a>
    </div>
    <div class="table-container">
        <table class="dive-table">
            <thead>
                <tr>
                    <th>
                        Datum
                    </th>
                    <th>
                        Dykledare
                    </th>
                    <th>
                        Dykare
                    </th>
                    <th>
                        Dykskötare
                    </th>
                    <th>
                        Dykplats
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Date.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DiveLeader.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Diver.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DiveSupport.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.LocationName)
                        </td>
                        <td>
                            <div class="button-wrapper">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="table-btn">Redigera</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="table-btn">Detaljer</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="table-btn">Ta bort</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index" asp-route-page="@i" class="@(ViewBag.CurrentPage == i ? "active-page" : "")">
                    @i
                </a>
            }
        </div>
    }
</div>

<div class="map-padding">
    <div id="big-map"></div>
</div>

@section Scripts {

    <script>

    var dives = [
         @foreach (var dive in Model) {
            if (dive.Latitude.HasValue && dive.Longitude.HasValue) {
                <text> {
                    id: @dive.Id,
                    lat: @dive.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    lng: @dive.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    location: "@dive.LocationName",
                    date: "@dive.Date.ToString("yyyy-MM-dd HH:mm")"
                    },
                </text>
            }
        }
    ];

    var map = L.map('big-map');

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    var markers = [];

    //Lägger till popup med plats, datum och länk till dyk.
    dives.forEach(function(dive) {

        var marker = L.marker([dive.lat, dive.lng])
            .addTo(map)
            .bindPopup(`
                <strong>${dive.location}</strong><br>
                ${dive.date}<br>
                <a href="/Dive/Details/${dive.id}">Visa dyk</a>
            `);

        markers.push(marker);
    });

    // Auto-zoom till alla markeringar
    if (markers.length > 0) {
        var group = L.featureGroup(markers);
        map.fitBounds(group.getBounds().pad(0.2));
    } else {
        map.setView([59.595, 16.56], 13);
    }

    </script>
}