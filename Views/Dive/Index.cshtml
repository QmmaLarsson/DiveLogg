@model IEnumerable<DiveLogg.Models.Dive>

@{
    ViewData["Title"] = "Index";
    Layout = "_LayoutPattern";
}

<h1>Dyklogg</h1>

<div class="page-container">
    <p>
        <a asp-action="Create" class="table-btn add-btn">Nytt dyk</a>
    </p>
    <div class="table-container">
        <table class="dive-table">
            <thead>
                <tr>
                    <th>
                        Datum
                    </th>
                    <th>
                        Dykledare
                    </th>
                    <th>
                        Dykare
                    </th>
                    <th>
                        Dykskötare
                    </th>
                    <th>
                        Dykplats
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Date.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DiveLeader.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Diver.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DiveSupport.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.LocationName)
                        </td>
                        <td>
                            <div class="button-wrapper">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="table-btn">Redigera</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="table-btn">Detaljer</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="table-btn">Ta bort</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index" asp-route-page="@i" class="@(ViewBag.CurrentPage == i ? "active-page" : "")">
                    @i
                </a>
            }
        </div>
    }
</div>