@model IEnumerable<DiveLogg.Models.Dive>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Lägg till dyk</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Datum
            </th>
            <th>
                Dykledare
            </th>
            <th>
                Dykare
            </th>
            <th>
                Dykskötare
            </th>
            <th>
                Djup
            </th>
            <th>
                Dyktid
            </th>
            <th>
                Expositionstid
            </th>
            <th>
                Kvävebelastning
            </th>
            <th>
                Dykplats
            </th>
            <th>
                Anteckningar
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DiveLeader.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Diver.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DiveSupport.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Depth)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DiveTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ExposureTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NitrogenLoad)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LocationName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Notes)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Redigera</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detaljer</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Ta bort</a>
                </td>
            </tr>
        }
    </tbody>
</table>