@model DiveLogg.Models.Dive

@{
    ViewData["Title"] = "Detaljer";
}

<h1>Detaljer</h1>

<div class="dive-form dive-details">
    <h3 class="dive-title">
        @Model.Date.ToString("yyyy-MM-dd HH:mm")
        – @Model.LocationName
    </h3>
    <div class="details-layout">

        <!-- Vänster kolumn, texter -->
        <dl class="details-list">

            <dt>Dykledare</dt>
            <dd>@Model.DiveLeader.Name</dd>

            <dt>Dykare</dt>
            <dd>@Model.Diver.Name</dd>

            <dt>Dykskötare</dt>
            <dd>@Model.DiveSupport.Name</dd>

            <dt>Djup</dt>
            <dd>@Model.Depth m</dd>

            <dt>Dyktid</dt>
            <dd>@Model.DiveTime</dd>

            <dt>Expositionstid</dt>
            <dd>@Model.ExposureTime</dd>

            <dt>Kvävebelastning</dt>
            <dd>@Model.NitrogenLoad</dd>

            <dt>Anteckningar</dt>
            <dd>@Model.Notes</dd>

        </dl>

        <!-- Karta -->
        <div class="map-placeholder">
            <span>Karta kommer här</span>
        </div>

    </div>
    <div class="details-buttons">
        <a class="submit-btn action-btn" asp-action="Edit" asp-route-id="@Model?.Id">Redigera</a>
        <a class="submit-btn action-btn" asp-action="Index">Tillbaka</a>
    </div>
</div>