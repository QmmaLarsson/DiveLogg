@model DiveLogg.Models.Dive

@{
    ViewData["Title"] = "Detaljer";
}

<h1>Detaljer</h1>

<div>
    <h4>Dive</h4>
    <dl>
        <dt>
            Datum
        </dt>
        <dd>
            @Model.Date.ToString("yyyy-MM-dd HH:mm")
        </dd>
        <dt>
            Dykledare
        </dt>
        <dd>
            @Html.DisplayFor(model => model.DiveLeader.Name)
        </dd>
        <dt>
            Dykare
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Diver.Name)
        </dd>
        <dt>
            Dykskötare
        </dt>
        <dd>
            @Html.DisplayFor(model => model.DiveSupport.Name)
        </dd>
        <dt>
            Djup
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Depth)
        </dd>
        <dt>
            Dyktid
        </dt>
        <dd>
            @Html.DisplayFor(model => model.DiveTime)
        </dd>
        <dt>
            Expositionstid
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ExposureTime)
        </dd>
        <dt>
            Kvävebelastning
        </dt>
        <dd>
            @Html.DisplayFor(model => model.NitrogenLoad)
        </dd>
        <dt>
            Latitud
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Latitude)
        </dd>
        <dt>
            Longitud
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Longitude)
        </dd>
        <dt>
            Dykplats
        </dt>
        <dd>
            @Html.DisplayFor(model => model.LocationName)
        </dd>
        <dt>
            Anteckningar
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Notes)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Redigera</a> |
    <a asp-action="Index">Tillbaka</a>
</div>