@model DiveLogg.Models.Dive

@{
    ViewData["Title"] = "Detaljer";
}

<h1>Detaljer</h1>

<div>
    <h4>Dive</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Datum
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class="col-sm-2">
            Dykledare
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DiveLeader.Name)
        </dd>
        <dt class="col-sm-2">
            Dykare
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Diver.Name)
        </dd>
        <dt class="col-sm-2">
            Dykskötare
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DiveSupport.Name)
        </dd>
        <dt class="col-sm-2">
            Djup
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Depth)
        </dd>
        <dt class="col-sm-2">
            Dyktid
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DiveTime)
        </dd>
        <dt class="col-sm-2">
            Expositionstid
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ExposureTime)
        </dd>
        <dt class="col-sm-2">
            Kvävebelastning
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NitrogenLoad)
        </dd>
        <dt class="col-sm-2">
            Latitud
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Latitude)
        </dd>
        <dt class="col-sm-2">
            Longitud
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Longitude)
        </dd>
        <dt class="col-sm-2">
            Dykplats
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LocationName)
        </dd>
        <dt class="col-sm-2">
            Anteckningar
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Redigera</a> |
    <a asp-action="Index">Tillbaka</a>
</div>