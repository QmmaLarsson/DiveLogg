@model DiveLogg.ViewModels.DiveCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Nytt dyk</h1>

<div>
    <div>
        <form asp-action="Create" class="dive-form">
            <h2>Dyk</h2>
            <!-- Felmeddelanden -->
            <div asp-validation-summary="All" class="error"></div>
            <div class="form-row">
                <label asp-for="Dive.Date">Datum: </label>
                <input asp-for="Dive.Date" class="date-input" />
            </div>

            <!-- Dykledare -->
            <div class="form-row">
                <label asp-for="Dive.DiveLeaderId">Dykledare: </label>
                <select asp-for="Dive.DiveLeaderId" asp-items="Model.DiveLeaders">
                    <option value=""></option>
                </select>
            </div>

            <!-- Dykare -->
            <div class="form-row">
                <label asp-for="Dive.DiverId">Dykare: </label>
                <select asp-for="Dive.DiverId" asp-items="Model.Divers">
                    <option value=""></option>
                </select>
            </div>

            <!-- Dykskötare -->
            <div class="form-row">
                <label asp-for="Dive.DiveSupportId">Dykskötare: </label>
                <select asp-for="Dive.DiveSupportId" asp-items="Model.DiveSupports">
                    <option value=""></option>
                </select>
            </div>

            <div class="form-row">
                <label asp-for="Dive.Depth">Djup: </label>
                <input asp-for="Dive.Depth" />
            </div>

            <div class="form-row">
                <label asp-for="Dive.DiveTime">Dyktid: </label>
                <input asp-for="Dive.DiveTime" />
            </div>

            <div class="form-row">
                <label asp-for="Dive.ExposureTime">Expositionstid: </label>
                <input asp-for="Dive.ExposureTime" />
            </div>

            <div class="form-row">
                <label asp-for="Dive.NitrogenLoad">Kvävebelastning: </label>
                <input asp-for="Dive.NitrogenLoad" />
            </div>

            <div class="form-row">
                <label asp-for="Dive.LocationName">Dykplats: </label>
                <input asp-for="Dive.LocationName" />
            </div>

            <div class="form-row">
                <label asp-for="Dive.Notes">Anteckningar: </label>
                <textarea asp-for="Dive.Notes"></textarea>
            </div>

            <div id="map"></div>
            <input asp-for="Dive.Latitude" id="Latitude" type="hidden" />
            <input asp-for="Dive.Longitude" id="Longitude" type="hidden" />

            <div>
                <input type="submit" value="Spara" class="submit-btn" />
            </div>
        </form>
    </div>
</div>

<div class="navigate-back">
    <a asp-action="Index">Tillbaka till Dyklogg</a>
</div>

@section Scripts {
    <script>
            var map = L.map('map');

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            var marker;

            //Om man har platstjänst aktiverad
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (position) {
                    var userLat = position.coords.latitude;
                    var userLng = position.coords.longitude;

                    //Zooma in på användarens position
                    map.setView([userLat, userLng], 15);
                }, function () {
                    //Om man inte har platstjänst aktiverad visas Västerås som default
                    map.setView([59.595, 16.56], 13);
                });
            } else {
                map.setView([59.595, 16.56], 13);
            }

            map.on('click', function (e) {

                var lat = e.latlng.lat.toFixed(6);
                var lng = e.latlng.lng.toFixed(6);

                if (marker) {
                    map.removeLayer(marker);
                }

                marker = L.marker([lat, lng]).addTo(map);

                document.getElementById("Latitude").value = lat.replace('.', ',');
                document.getElementById("Longitude").value = lng.replace('.', ',');
            });

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}