@model DiveLogg.Models.Dive

@{
    ViewData["Title"] = "Ta bort";
}

<h1>Ta bort</h1>

<h2>Är du säker på att du vill ta bort detta dyk?</h2>
<div class="dive-form dive-details">
    <h3 class="dive-title">
        @Model.Date.ToString("yyyy-MM-dd HH:mm")
        – @Model.LocationName
    </h3>
    <div class="details-layout">

        <!-- Vänster kolumn, texter -->
        <dl class="details-list">

            <dt>Dykledare</dt>
            <dd>@Model.DiveLeader.Name</dd>

            <dt>Dykare</dt>
            <dd>@Model.Diver.Name</dd>

            <dt>Dykskötare</dt>
            <dd>@Model.DiveSupport.Name</dd>

            <dt>Djup</dt>
            <dd>@Model.Depth m</dd>

            <dt>Dyktid</dt>
            <dd>@Model.DiveTime</dd>

            <dt>Expositionstid</dt>
            <dd>@Model.ExposureTime</dd>

            <dt>Kvävebelastning</dt>
            <dd>@Model.NitrogenLoad</dd>

            <dt>Anteckningar</dt>
            <dd>@Model.Notes</dd>

        </dl>

        <!-- Karta -->
        <div id="map"></div>

    </div>

    <form class="details-buttons" asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input class="submit-btn action-btn" type="submit" value="Ta bort" />
    </form>

</div>

<div class="navigate-back">
    <a asp-action="Index">Tillbaka till Dyklogg</a>
</div>

@section Scripts {

    <script>

        //Byter ut punkter i mina sparade koordinater till decimaler
        var lat = @Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lng = @Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);

        //Skapa karta
        var map = L.map('map').setView([lat, lng], 16);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        //Lägger till markör
        L.marker([lat, lng]).addTo(map);

    </script>

}