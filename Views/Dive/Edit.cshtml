@model DiveLogg.ViewModels.DiveEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Redigera</h1>

<div>
    <div>
        <form asp-action="Edit" method="post" class="dive-form">
            <h2>Dyk</h2>
            <!-- Felmeddelanden -->
            <div asp-validation-summary="All"></div>
            <div class="form-row">
                <label asp-for="DiveDate">Datum: </label>
                <input asp-for="DiveDate" class="date-input" />
            </div>

            <!-- Dykledare -->
            <div class="form-row">
                <label asp-for="DiveLeaderId">Dykledare: </label>
                <select asp-for="DiveLeaderId" asp-items="Model.DiveLeaders"></select>
            </div>

            <!-- Dykare -->
            <div class="form-row">
                <label asp-for="DiverId">Dykare: </label>
                <select asp-for="DiverId" asp-items="Model.Divers"></select>
            </div>

            <!-- Dykskötare -->
            <div class="form-row">
                <label asp-for="DiveSupportId">Dykskötare: </label>
                <select asp-for="DiveSupportId" asp-items="Model.DiveSupports">
                    <option value=""></option>
                </select>
            </div>

            <div class="form-row">
                <label asp-for="Depth">Djup: </label>
                <input asp-for="Depth" />
            </div>

            <div class="form-row">
                <label asp-for="DiveTime">Dyktid: </label>
                <input asp-for="DiveTime" />
            </div>

            <div class="form-row">
                <label asp-for="ExposureTime">Expositionstid: </label>
                <input asp-for="ExposureTime" />
            </div>

            <div class="form-row">
                <label asp-for="NitrogenLoad">Kvävebelastning: </label>
                <input asp-for="NitrogenLoad" />
            </div>

            <div class="form-row">
                <label asp-for="LocationName">Dykplats: </label>
                <input asp-for="LocationName" />
            </div>

            <div class="form-row">
                <label asp-for="Notes">Anteckningar:</label>
                <textarea asp-for="Notes"></textarea>
            </div>

            <input asp-for="Latitude" id="Latitude" type="hidden" />
            <input asp-for="Longitude" id="Longitude" type="hidden" />
            <div id="map"></div>

            <div>
                <input type="submit" value="Spara" class="submit-btn" />
            </div>
        </form>
    </div>
</div>

<div class="navigate-back">
    <a asp-action="Index">Tillbaka till Dyklogg</a>
</div>

@section Scripts {
    <script>

        //Hämta sparade koordinater
        var lat = @Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lng = @Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);

        // Skapa karta
        var map = L.map('map').setView([lat, lng], 16);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var marker = L.marker([lat, lng]).addTo(map);

        // Flytta markering vid klick
        map.on('click', function (e) {

            var newLat = e.latlng.lat.toFixed(6);
            var newLng = e.latlng.lng.toFixed(6);

            marker.setLatLng([newLat, newLng]);

            // Byter ut punkt mot decimal för korrekt format
            document.getElementById("Latitude").value =
                newLat.replace('.', ',');

            document.getElementById("Longitude").value =
                newLng.replace('.', ',');
        });

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}