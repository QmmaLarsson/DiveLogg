@model DiveLogg.ViewModels.DiveEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Redigera</h1>

<h4>Dyk</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">

            <div class="form-group">
                <label asp-for="DiveDate" class="control-label"></label>
                <input asp-for="DiveDate" class="form-control" />
                <span asp-validation-for="DiveDate" class="text-danger"></span>
            </div>

            <!-- Dykledare -->
            <div class="form-group">
                <label asp-for="DiveLeaderId" class="control-label"></label>
                <select asp-for="DiveLeaderId" asp-items="Model.DiveLeaders" class="form-control"></select>
                <span asp-validation-for="DiveLeaderId" class="text-danger"></span>
            </div>

            <!-- Dykare -->
            <div class="form-group">
                <label asp-for="DiverId" class="control-label"></label>
                <select asp-for="DiverId" asp-items="Model.Divers" class="form-control"></select>
                <span asp-validation-for="DiverId" class="text-danger"></span>
            </div>

            <!-- Dykskötare -->
            <div class="form-group">
                <label asp-for="DiveSupportId" class="control-label">Dykskötare: </label>
                <select asp-for="DiveSupportId" asp-items="Model.DiveSupports" class="form-control">
                    <option value=""></option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Depth" class="control-label"></label>
                <input asp-for="Depth" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="DiveTime" class="control-label"></label>
                <input asp-for="DiveTime" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="ExposureTime" class="control-label"></label>
                <input asp-for="ExposureTime" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="NitrogenLoad" class="control-label"></label>
                <input asp-for="NitrogenLoad" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Latitude" class="control-label"></label>
                <input asp-for="Latitude" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Longitude" class="control-label"></label>
                <input asp-for="Longitude" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="LocationName" class="control-label"></label>
                <input asp-for="LocationName" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <input asp-for="Notes" class="form-control" />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

            <!-- Felmeddelanden -->
            <div asp-validation-summary="All" class="text-danger mb-2"></div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Tillbaka till lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}