@{
    ViewData["Title"] = "Om oss";
    Layout = "_LayoutPattern";
}

<div>
    <section class="about-card">
        <div class="about-text">
            <h1>Om oss på<br>DiveLogg</h1>
            <img src="/images/Logotyp.png" alt="Logo">
            <p>
                DiveLogg startades som ett projekt av Anton Eriksson och Emma Larsson. Projektet har som mål att
                underlätta för räddningstjänster med dykberedskap att registrera dyk och organisera sina databaser för
                snabb och smidig åtkomst...
            </p>
        </div>
        <div class="about-image">
            <img src="/images/DiverStanding.jpg" alt="Dykare som står på isen">

            <div class="image-overlay1"></div>
            <div class="image-overlay2"></div>
            <div class="image-overlay3"></div>
        </div>
    </section>


</div>