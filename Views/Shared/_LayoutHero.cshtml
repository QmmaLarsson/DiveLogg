<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DiveLogg</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jura:wght@300..700&display=swap" rel="stylesheet">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layoutHero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DiveLogg.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="page-wrapper">
        <div class="hero-wrapper">

            <div class="hero-background"></div>

            <header class="hero-header">
                @await Html.PartialAsync("_Menu")
            </header>

            <div class="hero-content">
                @RenderSection("Hero", required: false)
            </div>

        </div>

        <div class="main-content">
            <main>
                @RenderBody()
            </main>
        </div>

        <footer>
            <p>&copy; 2026 - DiveLogg</p>
        </footer>
    </div>

</body>