<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DiveLogg</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jura:wght@300..700&display=swap" rel="stylesheet">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DiveLogg.styles.css" asp-append-version="true" />

    @RenderSection("LayoutStyles", required: false)
</head>

<body>

    <div class="main-content">
        <header>
            @await Html.PartialAsync("_Menu")
        </header>

        <main>
            @RenderBody()
        </main>
        
        <footer>
            <div>
                <p>&copy; 2026 - DiveLogg</p>
            </div>
        </footer>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>